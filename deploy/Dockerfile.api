# The API server and the Rust shim it execs.
#
# Two builders because the shim is a separate toolchain, and one small runtime
# holding both binaries. The Go binary is static (CGO_ENABLED=0); the Rust one
# links against glibc, which is why the runtime is debian-slim rather than
# scratch or an alpine.
#
# Nothing is installed in the runtime stage. That is not about image size: an
# `apt-get` here means the build fails whenever the base image's keyring is
# older than the keys the Debian archive is signed with -- NO_PUBKEY, on a line
# this repository did not write and cannot fix. Everything the runtime needs is
# either already in the base or copied out of a builder.
#
# Every image referenced here is on Docker Hub. gcr.io is not reachable from
# every network this is built on, so distroless is not an option however well it
# would otherwise fit.

# --- the shim ---------------------------------------------------------------
FROM rust:1-bookworm AS shim
WORKDIR /src

# An optional crates.io mirror, for networks where the upstream index is slow
# or blocked. Empty by default, and no value belongs in this repository: pass
# one at build time and it stays in your environment.
#
#   CARGO_REGISTRY_MIRROR=sparse+https://mirrors.ustc.edu.cn/crates.io-index/ \
#     make image
#
# Source replacement, not a different registry: crates still resolve by the
# names and versions in Cargo.lock and are still verified against its
# checksums, so `--locked` below means what it meant before. A mirror serving
# different bytes fails the build rather than changing what it produces.
ARG CARGO_REGISTRY_MIRROR=
RUN if [ -n "$CARGO_REGISTRY_MIRROR" ]; then \
        mkdir -p "$CARGO_HOME" \
        && printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n' \
            "$CARGO_REGISTRY_MIRROR" > "$CARGO_HOME/config.toml" \
        && echo "cargo: crates.io replaced with $CARGO_REGISTRY_MIRROR"; \
    fi

COPY rust/dolico-rs ./rust/dolico-rs
RUN cargo build --release --locked --manifest-path rust/dolico-rs/Cargo.toml

# --- the server -------------------------------------------------------------
FROM golang:1.25-bookworm AS server
WORKDIR /src
# No go.sum: this module has no third-party dependencies, so there is nothing
# to download and nothing to verify.
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dolico ./cmd/dolico
# Made here so it can be copied in with the right owner. The runtime stage has
# no shell to chown anything with.
RUN mkdir -p /out/data

# --- runtime ----------------------------------------------------------------
# debian-slim, with no package installed into it. It already carries what the
# two binaries need: glibc, and libgcc_s.so.1 for the dynamically linked Rust
# shim. Miss that second one -- as every scratch-like base does -- and the shim
# exits 127 the moment the API execs it, and the API refuses to start, which is
# the boot-time shim check working as intended.
FROM debian:bookworm-slim

# The one thing the base lacks and the old apt line installed. Taken from the
# builder, which has it already, rather than from the Debian archive.
COPY --from=server /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --from=server /out/dolico /usr/local/bin/dolico
COPY --from=shim /src/rust/dolico-rs/target/release/dolico-rs /usr/local/bin/dolico-rs
# Arrives owned by the user that writes to it. Docker initializes a named volume
# from whatever is at the mount point, ownership included, so getting this wrong
# means a root-owned volume the process cannot write to.
COPY --from=server --chown=10001:10001 /out/data /var/lib/dolico

# Set explicitly rather than relying on the binary's relative search, which
# looks for the shim next to a repository layout that does not exist here.
ENV DOLICO_SHIM_PATH=/usr/local/bin/dolico-rs \
    DOLICO_ADDR=:8080 \
    DOLICO_DATA_DIR=/var/lib/dolico

# Numeric rather than a `useradd`, which would mean running apt's world in the
# runtime stage for a passwd entry nothing reads: a uid is all the kernel
# checks. 10001 is load-bearing -- dolico-stack's deployment sets
# `fsGroup: 10001` to match it.
USER 10001:10001
EXPOSE 8080

# Liveness only. This checks the process and that the shim is executable; it
# says nothing about whether the OCR service is reachable.
#
# The binary probes itself. A HEALTHCHECK runs inside the container, and curl is
# not in the base -- installing one for this would put back the apt line the
# whole stage exists to avoid.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/dolico", "healthcheck"]

ENTRYPOINT ["/usr/local/bin/dolico"]
