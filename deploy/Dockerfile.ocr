# The OCR tier: PaddleOCR (Tier 1) and PP-StructureV3 (Tier 2).
#
# Deliberately not multi-stage. Paddle ships compiled shared objects with
# baked-in paths, and copying a virtualenv containing them between stages is a
# reliable source of subtle breakage. The image is larger for it; that is the
# trade being made on purpose.
#
# The vision tier is opt-in through OCR_EXTRAS, which is a space-separated
# list of extras turned into `--extra` flags below. It defaults to `structure`
# alone; building with OCR_EXTRAS="structure vision" adds Tier 3, which pulls
# torch and roughly triples the image, plus ~3.2GB of model weights on first
# run and ~7GB of memory per worker instead of ~3GB. See deploy/README.md
# before turning it on -- the memory figure is steady state, not a peak,
# because the disagreement probe keeps MinerU resident for every document
# with a scanned page.
#
# There are two Tier 3 engines and an image holds at most one of them:
# OCR_EXTRAS="structure vision" builds MinerU; "structure glm" builds GLM-OCR
# against its cloud API, and "structure glm-selfhosted" adds the local layout
# stage for pointing at your own model server. Naming two engines is refused
# below -- the image bakes in one DOLICO_VISION_ENGINE, and an image that
# disagrees with itself about which engine it holds is the failure this whole
# arrangement exists to prevent.
#
# Only `glm` is cheap. It is the cloud path, where Zhipu does layout and
# recognition both, so nothing model-shaped is installed: no torch, no
# transformers, and the image stays roughly the size it is without any Tier 3
# at all. `vision` and `glm-selfhosted` each add about a gigabyte of packages
# and gigabytes more of weights on first run.
#
# **This image is amd64 only.** PaddlePaddle ships no Linux aarch64 wheels --
# checked against PyPI, which has manylinux1_x86_64, macosx_11_0_arm64 and
# win_amd64 and nothing else. The compose file pins the platform accordingly;
# building this by hand on an arm64 host needs --platform linux/amd64 or it
# fails at dependency resolution.
FROM python:3.12-slim

# Pin this to a released uv version once you have chosen one; `latest` is used
# here only because the tag list could not be checked when this was written.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# An optional Debian mirror, for networks where deb.debian.org is slow enough
# to stall the build for half an hour. Empty by default; no value is committed.
#
#   DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn make image
#
# One substitution covers both suites, because the mirrors lay them out exactly
# as the archive does: /debian and /debian-security under the same host. The
# base image already carries CA certificates, so an https mirror works.
ARG DEBIAN_MIRROR=
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
        sed -i "s|http://deb\.debian\.org|$DEBIAN_MIRROR|g" \
            /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list 2>/dev/null || true; \
        echo "apt: deb.debian.org replaced with $DEBIAN_MIRROR"; \
    fi

# libgl1 and libglib2.0-0 are opencv's, libgomp1 is Paddle's. Without them the
# import fails at startup rather than at first request, which is at least loud.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10002 dolico

WORKDIR /app

# Everything below this line runs as the user the service runs as, and that is
# a build-time decision rather than a security one: it is worth about nine
# minutes a build.
#
# The venv is 1.4GB across ~20,000 files. Building it as root and then running
# `chown -R dolico:dolico /app` forces overlayfs to copy up every one of those
# files into a new layer -- measured at 562s on the build host, against 6s for
# the `uv sync` in the same step. Creating the files owned by the right user in
# the first place costs nothing.
#
# Two chowns of a single directory each, which is instant. /app because WORKDIR
# made it root-owned; ~/.paddlex because Docker seeds an empty named volume
# from whatever is at the mount point, ownership included -- without this the
# volume arrives root-owned, the non-root process cannot download models into
# it, and the failure surfaces several imports later as paddlex reporting "PDX
# has already been initialized", which says nothing about permissions.
RUN chown dolico:dolico /app \
    && mkdir -p /home/dolico/.paddlex \
    && chown dolico:dolico /home/dolico/.paddlex

USER dolico
# Before the first uv invocation, so its cache lands in this user's home rather
# than in root's.
ENV HOME=/home/dolico

# Dependencies first, so that editing the service does not reinstall Paddle.
ARG OCR_EXTRAS="structure"

# Which Tier 3 engine the extras asked for, derived rather than passed: a
# second argument could disagree with the first, and an image built with
# GLM-OCR installed but MinerU configured would report its vision tier
# unavailable and quietly serve two tiers.
# Empty means no Tier 3 in this image. It has to be empty rather than a word
# like "none", because the value is exported as DOLICO_VISION_ENGINE and
# `dolico_ocr.vision` refuses to start on a name it does not implement.
# Each extra is tested on its own rather than in one combined pattern. A
# pattern like *" vision "*" glm "* does not match "structure vision glm":
# the two extras share the space between them, and matching " vision "
# consumes it, so the " glm " that follows no longer has its leading space.
# That is the one input this check exists to catch, so it gets its own test.
RUN set -e; \
    padded=" $OCR_EXTRAS "; \
    has_vision=; has_glm=; \
    case "$padded" in *" vision "*) has_vision=1;; esac; \
    case "$padded" in *" glm "* | *" glm-selfhosted "*) has_glm=1;; esac; \
    if [ -n "$has_vision" ] && [ -n "$has_glm" ]; then \
        echo "OCR_EXTRAS names both vision and glm: $OCR_EXTRAS"; \
        echo "An image holds one Tier 3 engine: MinerU pins transformers<5,"; \
        echo "glmocr requires >=5.3, and no version satisfies both."; \
        exit 1; \
    elif [ -n "$has_vision" ]; then printf mineru  > /app/.vision-engine; \
    elif [ -n "$has_glm" ];    then printf glm-ocr > /app/.vision-engine; \
    else                            printf ''      > /app/.vision-engine; \
    fi; \
    if [ -s /app/.vision-engine ]; then \
        echo "Tier 3 engine: $(cat /app/.vision-engine)"; \
    else \
        echo "Tier 3 engine: none"; \
    fi

# Optional PyPI mirrors, for networks where upstream is slow or blocked. Both
# are empty by default and no value is committed -- see deploy/README.md.
#
# Two of them, because `uv sync --frozen` does not consult an index at all: the
# lock pins an absolute files.pythonhosted.org URL for every wheel, and uv
# downloads exactly those. An index-url alone changes nothing here, which is
# worth knowing before setting one and concluding the mirror is not working.
#
#   PYPI_FILES_MIRROR  rewrites that host in the lock. The mirrors serve the
#                      same /packages/... paths, so versions are unchanged and
#                      uv still checks every sha256 the lock records -- a mirror
#                      serving different bytes fails the build rather than
#                      quietly changing the image.
#   PIP_INDEX_URL      the index proper. Unused while --frozen holds; it is
#                      here for pip, and for a build that re-resolves.
ARG PYPI_FILES_MIRROR=
ARG PIP_INDEX_URL=

COPY --chown=dolico:dolico python/ocr-service/pyproject.toml python/ocr-service/uv.lock ./
RUN if [ -n "$PYPI_FILES_MIRROR" ]; then \
        sed -i "s|https://files\.pythonhosted\.org|$PYPI_FILES_MIRROR|g" uv.lock \
        && echo "uv.lock: wheel downloads redirected to $PYPI_FILES_MIRROR"; \
    fi

RUN ${PIP_INDEX_URL:+env UV_DEFAULT_INDEX="$PIP_INDEX_URL" PIP_INDEX_URL="$PIP_INDEX_URL"} \
    uv sync --frozen $(for e in $OCR_EXTRAS; do echo --extra $e; done) --no-install-project

COPY --chown=dolico:dolico python/ocr-service/dolico_ocr ./dolico_ocr
RUN ${PIP_INDEX_URL:+env UV_DEFAULT_INDEX="$PIP_INDEX_URL" PIP_INDEX_URL="$PIP_INDEX_URL"} \
    uv sync --frozen $(for e in $OCR_EXTRAS; do echo --extra $e; done)

ENV PATH=/app/.venv/bin:$PATH \
    DOLICO_OCR_WORKERS=2
EXPOSE 8181

# Models download to ~/.paddlex on first start and load per worker, so a cold
# container with an empty model volume is not ready for a while. start_period
# covers that; the compose file gives it longer still.
HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8181/healthz || exit 1

# exec so uvicorn is PID 1 and receives SIGTERM; shell form so the worker count
# stays a single environment variable rather than a rebuild.
# The engine comes from the build unless the environment overrides it, which
# is the only sane precedence: the image knows what was installed in it, and an
# operator who overrides it gets what they asked for -- including the refusal,
# if they name an engine this image does not carry.
CMD ["/bin/sh", "-c", \
     "V=${DOLICO_VISION_ENGINE:-$(cat /app/.vision-engine)}; \
      [ -n \"$V\" ] && export DOLICO_VISION_ENGINE=\"$V\"; \
      exec uvicorn dolico_ocr.app:app --host 0.0.0.0 --port 8181 --workers ${DOLICO_OCR_WORKERS}"]
